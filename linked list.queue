class Node {
    int data;
    Node next;

    Node(int data) {
        this.data = data;
        this.next = null;
    }
}

class Queue {
    Node front = null;
    Node rear = null;

    // Enqueue operation
    void enqueue(int value) {
        Node newNode = new Node(value);

        if (rear == null) {
            front = rear = newNode;
        } else {
            rear.next = newNode;
            rear = newNode;
        }

        System.out.println(value + " inserted into queue");
    }

    // Dequeue operation
    void dequeue() {
        if (front == null) {
            System.out.println("Queue Underflow");
        } else {
            System.out.println(front.data + " deleted from queue");
            front = front.next;

            if (front == null) {
                rear = null;
            }
        }
    }

    // Display operation
    void display() {
        if (front == null) {
            System.out.println("Queue is empty");
            return;
        }

        System.out.println("Queue elements:");

        Node temp = front;

        while (temp != null) {
            System.out.print(temp.data + " ");
            temp = temp.next;
        }

        System.out.println();
    }
}

public class QueueLinkedListDemo {
    public static void main(String[] args) {

        Queue q = new Queue();

        q.enqueue(10);
        q.enqueue(20);
        q.enqueue(30);

        q.display();

        q.dequeue();

        System.out.println("After dequeue:");
        q.display();
    }
}
